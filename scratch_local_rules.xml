<group name="modbus,suricata,ot_visibility,">
  <!-- Reactor Pressure Alerts (SIDs 1000020-1000021) -->
  <rule id="100025" level="12">
    <if_sid>86601</if_sid>
    <field name="alert.signature_id">^1000020$|^1000021$</field>
    <description>Suricata: HIGH REACTOR VALUE DETECTED - $(alert.signature)</description>
    <group>modbus_anomaly,industrial_security,reactor_critical,</group>
  </rule>

  <!-- Unauthorized Modbus Write Attempt (SID 1000030) -->
  <rule id="100026" level="12">
    <if_sid>86601</if_sid>
    <field name="alert.signature_id">^1000030$</field>
    <description>Suricata: SECURITY VIOLATION - Unauthorized Modbus Write Attempt</description>
    <group>modbus_write,policy_violation,industrial_security,intrusion_detection,</group>
  </rule>


  <!-- NEW VISIBILITY RULE: Ensure data.modbus object is captured -->
  <rule id="100030" level="3">
    <if_sid>86600</if_sid>
    <field name="event_type">^modbus$</field>
    <description>Suricata: Modbus Transaction [Func: $(modbus.function), Unit: $(modbus.unit_id)]</description>
    <group>modbus_visibility,protocol_metadata,</group>
  </rule>

  <!-- CRITICAL: PLC Management Console Login Successful (Suricata Escalation) -->
  <rule id="100060" level="12">
    <if_sid>86601</if_sid>
    <field name="alert.signature_id">^1000101$</field>
    <description>PLC Management Console: Successful Admin Login Detected</description>
    <group>industrial_security,plc_admin,access_critical,</group>
  </rule>
</group>

<group name="local,syslog,sshd,">
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>
</group>
<group name="keycloak,auth,">
  <!-- Base rule for Keycloak logs (matching the logger name) -->
  <rule id="100500" level="3">
    <decoded_as>json</decoded_as>
    <field name="loggerName">org.keycloak.events</field>
    <description>Keycloak event occurred</description>
  </rule>

  <!-- Detect Successful Logins -->
  <rule id="100501" level="3">
    <if_sid>100500</if_sid>
    <field name="message">type=LOGIN</field>
    <description>Keycloak: User Login Successful</description>
    <group>authentication_success,pci_dss_10.2.5,</group>
  </rule>

  <!-- Detect Failed Logins -->
  <rule id="100502" level="5">
    <if_sid>100500</if_sid>
    <field name="message">type=LOGIN_ERROR</field>
    <description>Keycloak: User Login Failed</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

  <!-- Detect Administrative Logins -->
  <rule id="100503" level="3">
    <if_sid>100501</if_sid>
    <field name="message">clientId=security-admin-console</field>
    <description>Keycloak: Administrative Login Successful</description>
    <group>admin_access,</group>
  </rule>

  <!-- Detect Identity-Based Login specifically for PLC access via Pomerium -->
  <rule id="100510" level="12">
    <if_sid>100501</if_sid>
    <field name="message">redirect_uri=https://plc.localhost.pomerium.io</field>
    <description>Keycloak: Successful Identity-Based Login for PLC Access (Pomerium)</description>
    <group>authentication_success,pomerium_access,plc_critical,</group>
  </rule>
</group>
