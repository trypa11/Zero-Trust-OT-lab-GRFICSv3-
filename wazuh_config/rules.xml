<!-- ===================== KEYCLOAK (IdP) ===================== -->
<group name="keycloak,auth,">

  <!-- Base rule: any Keycloak event -->
  <rule id="100500" level="3">
    <decoded_as>json</decoded_as>
    <field name="loggerName">org.keycloak.events</field>
    <description>Keycloak event occurred</description>
  </rule>

  <!-- FAILED Login (check this FIRST - more specific pattern) -->
  <rule id="100502" level="5">
    <if_sid>100500</if_sid>
    <field name="message">LOGIN_ERROR</field>
    <description>Keycloak: User Login Failed - $(message)</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

  <!-- SUCCESSFUL Login (only fires if LOGIN_ERROR didn't match) -->
  <rule id="100501" level="3">
    <if_sid>100500</if_sid>
    <field name="message">type=LOGIN\b</field>
    <description>Keycloak: User Login Successful</description>
    <group>authentication_success,pci_dss_10.2.5,</group>
  </rule>

  <!-- Administrative Console Login -->
  <rule id="100503" level="5">
    <if_sid>100501</if_sid>
    <field name="message">clientId=security-admin-console</field>
    <description>Keycloak: Administrative Console Login - $(message)</description>
    <group>admin_access,pci_dss_10.2.1,</group>
  </rule>

  <!-- IDENTITY-BASED PLC ACCESS (via Pomerium) -->
  <rule id="100510" level="12">
    <if_sid>100501</if_sid>
    <field name="message">plc.localhost.pomerium.io</field>
    <description>Keycloak: Direct Identity-Based PLC Access Granted to $(user) (Pomerium)</description>
    <group>authentication_success,pomerium_access,plc_critical,pci_dss_10.2.1,</group>
  </rule>

  <!-- BRUTE FORCE: Multiple failed logins from same IP (5+ in 60s) -->
  <rule id="100520" level="10" frequency="5" timeframe="60">
    <if_matched_sid>100502</if_matched_sid>
    <same_srcip/>
    <description>Keycloak: BRUTE FORCE - Multiple failed logins from $(srcip) (5+ in 60s)</description>
    <group>authentication_failed,brute_force,pci_dss_11.4,gdpr_IV_35.7.d,</group>
  </rule>

  <!-- CREDENTIAL STUFFING: Sustained login failure flood (10+ in 120s) -->
  <rule id="100521" level="13" frequency="10" timeframe="120">
    <if_matched_sid>100502</if_matched_sid>
    <same_srcip/>
    <description>Keycloak: CREDENTIAL STUFFING - Sustained login failures from $(srcip) (10+ in 120s)</description>
    <group>authentication_failed,credential_stuffing,pci_dss_11.4,gdpr_IV_35.7.d,</group>
  </rule>

</group>

<!-- ===================== GUACAMOLE (Remote Access to EWS only) ===================== -->
<group name="guacamole,syslog,">

  <!-- Base Guacamole event -->
  <rule id="100100" level="0">
    <decoded_as>guacamole</decoded_as>
    <description>Guacamole events</description>
  </rule>

  <!-- Guacamole Login Success -->
  <rule id="100101" level="3">
    <if_sid>100100</if_sid>
    <match>successfully authenticated</match>
    <description>Guacamole: User $(user) authenticated successfully</description>
    <group>authentication_success,pci_dss_10.2.5,gpg13_7.1,gdpr_IV_32.2,</group>
  </rule>

  <!-- Guacamole Login Failure -->
  <rule id="100102" level="5">
    <if_sid>100100</if_sid>
    <match>Authentication failed|invalid login</match>
    <description>Guacamole: User authentication failed - $(user)</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,gpg13_7.1,gdpr_IV_35.7.d,hipaa_164.312.b,</group>
  </rule>

  <!-- Guacamole Brute-force Protection Triggered -->
  <rule id="100105" level="7">
    <if_sid>100100</if_sid>
    <match>Blocking authentication attempt</match>
    <description>Guacamole: Brute-force protection triggered for IP $(srcip)</description>
