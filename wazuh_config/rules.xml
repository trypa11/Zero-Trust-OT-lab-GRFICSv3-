    <group>connection_start,audit,pci_dss_10.2.1,</group>
  </rule>

  <!-- Guacamole EWS Session End -->
  <rule id="100104" level="3">
    <if_sid>100100</if_sid>
    <match>disconnected from connection</match>
    <description>Guacamole: User $(user) ended EWS session: $(connection_name)</description>
    <group>connection_end,audit,pci_dss_10.2.1,</group>
  </rule>

  <!-- BRUTE FORCE: Multiple failed logins (5+ in 60s) -->
  <rule id="100110" level="10" frequency="5" timeframe="60">
    <if_matched_sid>100102</if_matched_sid>
    <same_srcip/>
    <description>Guacamole: BRUTE FORCE - Multiple failed EWS logins from $(srcip) (5+ in 60s)</description>
    <group>authentication_failed,brute_force,pci_dss_11.4,gdpr_IV_35.7.d,</group>
  </rule>

</group>

