<!-- ===================== FIREWALL DROPS (Visibility) ===================== -->
<group name="firewall_drops,ot_recon_auditing,">
  <rule id="100040" level="3">
    <decoded_as>json</decoded_as>
    <field name="oob.prefix">^FW DROP: </field>
    <description>Firewall: Packet dropped by router</description>
    <group>firewall_drop,ot_recon_auditing,</group>
  </rule>

  <rule id="100041" level="7">
    <if_sid>100040</if_sid>
    <field name="dest_port">^502$</field>
    <description>Firewall: Unauthorized Modbus access attempt blocked (port 502)</description>
    <group>modbus_recon,firewall_drop,industrial_security,ot_recon_auditing,</group>
  </rule>

  <rule id="100042" level="7">
    <if_sid>100040</if_sid>
    <field name="dest_port">^22$|^80$|^443$|^3389$|^8080$</field>
    <description>Firewall: Unauthorized access attempt to critical port $(dest_port) blocked</description>
    <group>network_recon,firewall_drop,industrial_security,ot_recon_auditing,</group>
  </rule>
</group>
